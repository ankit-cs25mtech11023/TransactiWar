# Disable directory listing
Options -Indexes

# -----------------------------------------------------------------------------
# Block access to sensitive files and folders
# -----------------------------------------------------------------------------

# 1) Deny access to sensitive directories (never meant to be web-accessible)
#    - database/: SQL dumps / schema
#    - config/: server config, SSL material, etc.
#    - scripts/: maintenance scripts
#    - auth/ is part of the app, so DO NOT block it.
RewriteEngine On
RewriteRule ^(?:database|config|scripts)(?:/|$) - [F,L]

# 2) Deny access to sensitive dotfiles and repo metadata
<FilesMatch "(?i)^(?:\.env|\.git.*|\.dockerignore|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# 3) Deny access to common sensitive file types (backups, dumps, configs, keys)
<FilesMatch "(?i)\.(?:sql|sqlite|db|bak|backup|old|orig|swp|tmp|log|ini|conf|cnf|yml|yaml|pem|key|crt|p12|pfx|kdbx|zip|tar|tgz|gz|7z|rar)$">
    Require all denied
</FilesMatch>

# 4) Deny access to container/build files
<FilesMatch "(?i)^(?:Dockerfile|docker-compose\.ya?ml)$">
    Require all denied
</FilesMatch>

# 5) Deny access to documentation/exports that may leak internals
<FilesMatch "(?i)\.(?:md|csv)$">
    Require all denied
</FilesMatch>
